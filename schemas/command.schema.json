{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCL Command",
  "type": "object",
  "required": [
    "name",
    "version",
    "default_action"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "default_action": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "object"
    }
  }
}